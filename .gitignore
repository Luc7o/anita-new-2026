# ---------- Backend ----------
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/instance/

# Archivos subidos por usuarios (se conservan solo los .gitkeep)
backend/app/static/uploads/productos/*
!backend/app/static/uploads/productos/.gitkeep
backend/app/static/uploads/comprobantes/*
!backend/app/static/uploads/comprobantes/.gitkeep
backend/app/static/uploads/pagos/*
!backend/app/static/uploads/pagos/.gitkeep

# ---------- Frontend ----------
frontend/node_modules/
frontend/dist/

# ---------- Secretos: variables de entorno ----------
# Con punto (lo normal)
.env
.env.*
!.env.example
# Sin punto (como están ahora en tu proyecto)
backend/env
frontend/env

# ---------- Vercel ----------
# Se crea al correr `vercel link` / `vercel dev`
.vercel/

# ---------- Sistema ----------
.DS_Store
Thumbs.db