+# Cifras de dinero "completas" (referencia financiera). El rol Ventas ve su
+# dashboard de ventas pero sin estas (ver comentario en app/roles.py).
+_CLAVES_FINANCIERAS = (
+    "monto_pagos_pendientes", "monto_en_revision", "monto_rechazado",
+    "monto_reembolsos", "monto_cancelado",
+)
+# Todo lo que revela ingresos, ventas o tráfico: Almacén no lo recibe.
+_CLAVES_DE_VENTAS = _CLAVES_FINANCIERAS + (
+    "ventas_total", "ventas_confirmadas", "ventas_por_mes", "top_categorias",
+    "pedidos_recientes", "productos_top", "total_clientes",
+    "visitas_hoy", "visitantes_hoy", "visitantes_7dias", "visitas_por_dia",
+)
+
+
+def _filtrar_estadisticas_por_rol(data, rol):
+    """
+    El dashboard lo ven varios roles, cada uno con lo suyo (ver app/roles.py):
+      - superadmin / administrativo / auditor: todo
+      - ventas: todo menos las cifras financieras de referencia
+      - almacén: solo conteos operativos y de stock, nada de ingresos
+    Se recorta acá, en el servidor, para que el dato ni siquiera salga en la
+    respuesta (ocultarlo solo en pantalla no protegería nada).
+    """
+    if rol in PUEDE_VER_DASHBOARD:
+        return data
+    if rol in PUEDE_VER_DASHBOARD_VENTAS:
+        quitar = _CLAVES_FINANCIERAS
+    else:
+        quitar = _CLAVES_DE_VENTAS
+    return {k: v for k, v in data.items() if k not in quitar}
+
