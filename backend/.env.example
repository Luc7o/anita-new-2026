SECRET_KEY=cambia-esto-por-una-clave-larga-aleatoria
JWT_SECRET_KEY=cambia-esto-tambien-por-otra-clave

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=anita_new_style

FRONTEND_ORIGIN=http://localhost:5173

# Correo transaccional vía Resend (https://resend.com).
# Mientras RESEND_API_KEY esté vacío, los correos NO se envían de verdad:
# se imprimen en la consola de "python run.py" para poder probar el flujo
# de registro / recuperación de contraseña sin tener la cuenta lista todavía.
#
# Cuando la tengas:
# 1. Crea tu cuenta en https://resend.com y genera una API key.
# 2. Verifica tu dominio de envío (o usa el de pruebas que da Resend).
# 3. Pega la key aquí y pon el remitente que verificaste.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-responder@anitanewstyle.com

# Validación de DNI / RUC vía APIs Perú.
# Muchos proveedores existen (decolecta/apis.net.pe, apiperu.dev, dniruc.com,
# apidni.com, etc). Todos siguen el mismo patrón: GET con
# "Authorization: Bearer TU_TOKEN". Por defecto apunta a decolecta, que
# actualmente solo ofrece consulta de RUC de forma pública (la consulta
# pública de DNI/RENIEC fue descontinuada por normativa de protección de
# datos) — si necesitas también DNI, revisa qué proveedor lo sigue ofreciendo
# y cambia API_PERU_BASE_URL.
#
# Mientras API_PERU_TOKEN esté vacío, el botón "validar" del registro no
# autocompleta nada, pero el registro sigue funcionando normalmente sin bloquearse.
API_PERU_TOKEN=
API_PERU_BASE_URL=https://api.decolecta.com
