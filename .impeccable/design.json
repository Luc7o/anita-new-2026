      "name": "Cinta",
      "kind": "button",
      "refersTo": "cinta",
      "description": "La única acción principal: Agregar a mi bolsa, Pagar, Cobrar.",
      "html": "<button class=\"ds-cinta\">Agregar a mi bolsa</button>",
      "css": ":host{--bolsa:#16131a;--bolsa-2:#24202a;--seda:#a53694;--seda-claro:#c24fae;--seda-hondo:#7e2470;--seda-niebla:#f4e4f0;--boleta:#fbfaf8;--papel:#efedf0;--kraft:#b98b5e;--kraft-claro:#d9b48c;--tinta:#1c1a1d;--tinta-suave:#5c5660;--linea:rgb(28 26 29 / .14);--linea-fuerte:rgb(28 26 29 / .32);--sobre-oscuro-suave:#c9c0c8;--exito:#15803d;--exito-fondo:#e6f4ea;--aviso:#92400e;--aviso-fondo:#fdf1dc;--peligro:#b91c1c;--peligro-fondo:#fdeaea;--salida:cubic-bezier(0.16,1,0.3,1);font-family:Manrope,ui-sans-serif,system-ui,sans-serif;color:var(--tinta)} .ds-cinta{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 22px;border-radius:10px;border:0;cursor:pointer;font:700 16px Manrope,ui-sans-serif,sans-serif;transition:background-color .2s,transform .15s var(--salida),box-shadow .2s;background:var(--seda);color:#fff;box-shadow:0 10px 22px -12px var(--seda-hondo)} .ds-cinta:hover{background:var(--seda-hondo)} .ds-cinta:active{transform:scale(.98)} .ds-cinta:focus-visible{outline:2.5px solid var(--seda);outline-offset:3px;}"
    },
